# Loaded by prisma.config.ts (via dotenv) for host-side Prisma CLI runs.
# Inside Docker, docker-compose.yml sets DATABASE_URL to the postgres service
# instead, and dotenv does not override variables that are already set.
# Credentials must match POSTGRES_* in the repo root .env.
DATABASE_URL="postgresql://heliotyper:heliotyper_dev@localhost:5432/heliotyper"
